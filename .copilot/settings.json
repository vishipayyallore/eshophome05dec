{
  "$schema": "https://schemas.github.com/copilot/settings.json",
  "languageConfigs": {
    "*": {
      "enabled": true,
      "chatEnabled": true,
      "inlineEnabled": true
    },
    "html": {
      "style": {
        "commentDriven": true,
        "preferredFramework": "vanilla",
        "notes": "Use Tailwind via CDN plus light custom CSS; apply sky-blue glassmorphism design."
      }
    },
    "css": {
      "style": {
        "framework": "tailwind+custom",
        "notes": "Prefer utility classes; keep custom CSS focused on glassmorphism and animations."
      }
    },
    "javascript": {
      "style": {
        "framework": "vanilla",
        "notes": "Use small, focused functions for interactions (carousel, smooth scroll, toggles). No frameworks."
      }
    }
  },
  "policies": {
    "respectRepoInstructions": true,
    "avoidLargeBinaries": true,
    "avoidNewFrameworks": true
  }
}
